{
  "expo": {
    "name": "Barbie Period Tracker",
    "slug": "barbie-period-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "barbietracker",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.barbie.periodtracker"
    },
    "android": {
      "package": "com.barbie.periodtracker",
      "adaptiveIcon": {
        "backgroundColor": "#FFF0F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF0F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF4FA3"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Barbie Period Tracker to use Face ID to protect your private journal."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Barbie Period Tracker to access your photos for scrapbook memories."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
